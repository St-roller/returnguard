    "negative_mask": ["(?:吊牌|标签)[^，。！？；\\n]{0,5}(?:没|没有|未|不曾)[^，。！？；\\n]{0,2}(?:剪掉|剪下|拆掉|拆下|摘掉|摘下|取下)"],
