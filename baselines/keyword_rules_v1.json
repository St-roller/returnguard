    "present": ["有污渍", "弄脏", "蹭脏", "脏了", "有破损", "破了", "坏了", "有破洞", "开线", "损坏"],
    "negative_mask": ["(?:没有|没|未|无|不曾)(?:[^，。！？；\\n]{0,2})(?:污渍|破损|破洞|弄脏|弄破|蹭脏|脏|破|坏|开线|损坏)(?:了)?"],
